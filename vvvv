local function createToggle(parent, title, description, key)
    local row = createRow(parent, title, description, 58, 95)
    local track = Instance.new("TextButton")
    track.Name = key .. "Toggle"
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -14, 0.5, 0)
    track.Size = UDim2.fromOffset(46, 24)
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row
    round(track, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.BorderSizePixel = 0
    knob.Parent = track
    round(knob, 9)

    local info = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local function refresh(animate)
        local enabled = Settings[key]
        local trackColor = enabled and WHITE or Colors.Off
        local knobColor = enabled and Color3.fromRGB(14, 14, 17) or Color3.fromRGB(225, 226, 232)
        local knobPosition = enabled and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        if animate then
            TweenService:Create(track, info, {BackgroundColor3 = trackColor}):Play()
            TweenService:Create(knob, info, {BackgroundColor3 = knobColor, Position = knobPosition}):Play()
        else
            track.BackgroundColor3 = trackColor
            knob.BackgroundColor3 = knobColor
            knob.Position = knobPosition
        end
    end

    track.MouseButton1Click:Connect(function()
        Settings[key] = not Settings[key]
        refresh(true)
        if TOAST_TOGGLES[key] then
            notify(title .. ": " .. (Settings[key] and "ON" or "OFF"), Settings[key] and "success" or "info")
        end
    end)
    refresh(false)
    table.insert(Refreshers, function() refresh(false) end)
    return row
end

local function createSlider(parent, title, description, key, minValue, maxValue, step)
    local row = createRow(parent, title, description, 64)
    local valueLabel = makeLabel(row, "", UDim2.new(1, -164, 0, 8), UDim2.fromOffset(150, 16), 12, WHITE, Fonts.Bold, Enum.TextXAlignment.Right)

    local track = Instance.new("Frame")
    track.Position = UDim2.new(1, -164, 0, 42)
    track.Size = UDim2.fromOffset(150, 4)
    track.BackgroundColor3 = Colors.Track
    track.BorderSizePixel = 0
    track.Active = true
    track.Parent = row
    round(track, 2)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = WHITE
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, 2)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = WHITE
    knob.BorderSizePixel = 0
    knob.Active = true
    knob.Parent = track
    round(knob, 7)

    local decimals = (step < 1) and 2 or 0
    local format = "%." .. decimals .. "f"

    local function refresh()
        local value = math.clamp(tonumber(Settings[key]) or minValue, minValue, maxValue)
        local ratio = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = string.format(format, value)
    end

    local function setFromX(mouseX)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local ratio = math.clamp((mouseX - track.AbsolutePosition.X) / width, 0, 1)
        local raw = minValue + (maxValue - minValue) * ratio
        local value = minValue + math.floor((raw - minValue) / step + 0.5) * step
        Settings[key] = tonumber(string.format(format, math.clamp(value, minValue, maxValue)))
        refresh()
    end

    local function begin(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setFromX(input.Position.X)
            Drag.Handler = setFromX
        end
    end
    track.InputBegan:Connect(begin)
    knob.InputBegan:Connect(begin)

    refresh()
    table.insert(Refreshers, refresh)
    return row
end

-- Left click = next option, right click = previous option.
local function createDropdown(parent, title, description, key, options)
    local row = createRow(parent, title, description, 58)
    local button = createRowButton(row)

    local function refresh() button.Text = tostring(Settings[key]) .. "  ▾" end
    local function cycle(step)
        local index = table.find(options, Settings[key]) or 0
        Settings[key] = options[((index - 1 + step) % #options) + 1]
        refresh()
    end
    button.MouseButton1Click:Connect(function() cycle(1) end)
    button.MouseButton2Click:Connect(function() cycle(-1) end)

    refresh()
    table.insert(Refreshers, refresh)
    return row
end

local function createActionButton(parent, title, description, buttonText, callback, danger)
    local row = createRow(parent, title, description, 58)
    local button = createRowButton(row, Fonts.Bold)
    button.Text = buttonText
    if danger then
        button.BackgroundColor3 = Color3.fromRGB(44, 18, 22)
        button.TextColor3 = Color3.fromRGB(255, 150, 158)
    end
    button.MouseButton1Click:Connect(callback)
    return row
end

