local function findGuiParent()
    if type(gethui) == "function" then
        local ok, hidden = pcall(gethui)
        if ok and hidden then return hidden, "gethui()" end
    end

    local ok = pcall(function()
        local probe = Instance.new("Folder")
        probe.Parent = CoreGui
        probe:Destroy()
    end)
    if ok then return CoreGui, "CoreGui" end

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
    if playerGui then return playerGui, "PlayerGui" end
    return nil, "none"
end

local GuiParent, GuiParentName = findGuiParent()
if not GuiParent then
    warn("[vanta.lol] Could not find a GUI parent.")
    return
end

for _, name in ipairs(OLD_GUI_NAMES) do
    local old = GuiParent:FindFirstChild(name)
    if old then pcall(function() old:Destroy() end) end
end

