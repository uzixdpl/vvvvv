-- Aimbot
-- ============================================================
local AimCircle = Instance.new("Frame")
AimCircle.Name = "AimFOVCircle"
AimCircle.AnchorPoint = Vector2.new(0.5, 0.5)
AimCircle.BackgroundTransparency = 1
AimCircle.BorderSizePixel = 0
AimCircle.Visible = false
AimCircle.ZIndex = 20
AimCircle.Parent = ScreenGui
round(AimCircle, 1000)
stroke(AimCircle, WHITE, 1.5, 0.2)

local Aimbot = {LockedPlayer = nil, MouseWarned = false, MouseResidual = Vector2.new()}

local function isAimActive()
    local mode = Settings.AimbotActivation
    if mode == "Always" then return true end
    local button = (mode == "LMB") and Enum.UserInputType.MouseButton1 or Enum.UserInputType.MouseButton2
    return UserInputService:IsMouseButtonPressed(button)
end

-- Mouse mode targets around the cursor (when it is free), Camera mode around the screen center.
local function getAimReference(camera)
    if Settings.AimbotMode == "Mouse" and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
        return UserInputService:GetMouseLocation()
    end
    return camera.ViewportSize / 2
end

local function aimAt(camera, targetPart, reference, dt)
    -- Frame-rate independent smoothing: same feel at 60 and 240 FPS.
    local frameTime = math.clamp(dt or (1 / 60), 0, 0.1)
    local smoothness = math.clamp(Settings.AimbotSmoothness, 0.01, 1)
    local alpha = 1 - (1 - smoothness) ^ (frameTime * 60)

    -- Smoothing makes the aim trail behind a moving target; "Tracking" aims that much ahead.
    local trailTime = 0
    if alpha > 0 then trailTime = math.min(frameTime * (1 - alpha) / alpha, 0.25) end
    local leadTime = Settings.AimbotPrediction + trailTime * Settings.AimbotTracking
    local aimPosition = targetPart.Position + targetPart.AssemblyLinearVelocity * leadTime

    if Settings.AimbotMode == "Mouse" then
        if type(mousemoverel) == "function" then
            local screenPoint, onScreen = camera:WorldToViewportPoint(aimPosition)
            if onScreen and screenPoint.Z > 0 then
                -- mousemoverel only takes whole pixels: keep the fractional rest so slow tracking never stalls.
                local residual = Aimbot.MouseResidual
                    + Vector2.new(screenPoint.X - reference.X, screenPoint.Y - reference.Y) * alpha
                local stepX = residual.X >= 0 and math.floor(residual.X) or math.ceil(residual.X)
                local stepY = residual.Y >= 0 and math.floor(residual.Y) or math.ceil(residual.Y)
                if stepX ~= 0 or stepY ~= 0 then
                    pcall(mousemoverel, stepX, stepY)
                    residual = residual - Vector2.new(stepX, stepY)
                end
                Aimbot.MouseResidual = residual
            else
                Aimbot.MouseResidual = Vector2.new()
            end
            return
        elseif not Aimbot.MouseWarned then
            Aimbot.MouseWarned = true
            notify("mousemoverel() not available - using Camera mode", "error")
        end
    end

    camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, aimPosition), alpha)
end

local function updateAimbot(camera, dt)
    local reference = getAimReference(camera)
    AimCircle.Visible = Settings.Aimbot and Settings.ShowFOV
    if AimCircle.Visible then
        AimCircle.Position = UDim2.fromOffset(reference.X, reference.Y)
        AimCircle.Size = UDim2.fromOffset(Settings.AimbotFOV * 2, Settings.AimbotFOV * 2)
    end

    if not Settings.Aimbot or menuOpen or not isAimActive() then
        Aimbot.LockedPlayer = nil
        Aimbot.MouseResidual = Vector2.new()
        return
    end

    -- Target lock: keep the current target while it stays valid (no flicker between targets).
    local targetPart = nil
    if Aimbot.LockedPlayer then
        targetPart = evaluateCandidate(Aimbot.LockedPlayer, camera, reference)
    end
    if not targetPart then
        targetPart, Aimbot.LockedPlayer = findBestTarget(camera, reference)
    end

    if targetPart then
        aimAt(camera, targetPart, reference, dt)
    end
end

-- ============================================================
-- ESP: skeleton + distance
-- ============================================================
local PlayerOverlays = {}

local R15_BONES = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}
local R6_BONES = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

-- Draws a line between two screen points using a centered, rotated frame.
local function setLine(frame, a, b, thickness)
    local delta = b - a
    frame.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    frame.Size = UDim2.fromOffset(delta.Magnitude, thickness)
    frame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    frame.Visible = true
end

local function hideBones(overlay)
    for _, bone in ipairs(overlay.Bones) do bone.Visible = false end
end

local function hideOverlay(overlay)
    overlay.Distance.Visible = false
    hideBones(overlay)
end

local function removePlayerOverlay(player)
    local overlay = PlayerOverlays[player]
    if not overlay then return end
    pcall(function() overlay.Distance:Destroy() end)
    for _, bone in ipairs(overlay.Bones) do
        pcall(function() bone:Destroy() end)
    end
    PlayerOverlays[player] = nil
end

local function createPlayerOverlay(player)
    if player == LocalPlayer or PlayerOverlays[player] then return end
    local id = tostring(player.UserId)

    local bones = {}
    for i = 1, #R15_BONES do
        local bone = Instance.new("Frame")
        bone.Name = "ESPBone_" .. id .. "_" .. i
        bone.AnchorPoint = Vector2.new(0.5, 0.5)
        bone.BackgroundColor3 = WHITE
        bone.BorderSizePixel = 0
        bone.Visible = false
        bone.ZIndex = 28
        bone.Parent = ScreenGui
        bones[i] = bone
    end

    local distance = Instance.new("TextLabel")
    distance.Name = "ESPDistance_" .. id
    distance.BackgroundTransparency = 1
    distance.BorderSizePixel = 0
    distance.Size = UDim2.fromOffset(80, 16)
    distance.Font = Fonts.Bold
    distance.TextSize = 13
    distance.TextColor3 = WHITE
    distance.TextStrokeColor3 = Color3.new(0, 0, 0)
    distance.TextStrokeTransparency = 0.3
    distance.TextXAlignment = Enum.TextXAlignment.Center
    distance.Visible = false
    distance.ZIndex = 31
    distance.Parent = ScreenGui

    PlayerOverlays[player] = {Bones = bones, Distance = distance}
end

local function updateSkeleton(overlay, character, camera)
    local bones = character:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
    for i, frame in ipairs(overlay.Bones) do
        local drawn = false
        local pair = bones[i]
        if pair then
            local partA = character:FindFirstChild(pair[1])
            local partB = character:FindFirstChild(pair[2])
            if partA and partB then
                local a = camera:WorldToViewportPoint(partA.Position)
                local b = camera:WorldToViewportPoint(partB.Position)
                if a.Z > 0 and b.Z > 0 then
                    setLine(frame, Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y), Settings.SkeletonThickness)
                    drawn = true
                end
            end
        end
        if not drawn then frame.Visible = false end
    end
end

local function updatePlayerOverlay(player, overlay, camera)
    if not Settings.ESPSkeleton and not Settings.ESPDistance then return hideOverlay(overlay) end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then return hideOverlay(overlay) end
    if Settings.TeamCheck and isTeammate(player) then return hideOverlay(overlay) end

    local rootScreen, onScreen = camera:WorldToViewportPoint(root.Position)
    if not onScreen or rootScreen.Z <= 0 then return hideOverlay(overlay) end

    if Settings.ESPSkeleton then
        updateSkeleton(overlay, character, camera)
    else
        hideBones(overlay)
    end

    overlay.Distance.Visible = Settings.ESPDistance
    if Settings.ESPDistance then
        local feet = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local origin = localRoot and localRoot.Position or camera.CFrame.Position
        local meters = math.floor((root.Position - origin).Magnitude + 0.5)
        overlay.Distance.Position = UDim2.fromOffset(feet.X - 40, feet.Y + 2)
        overlay.Distance.Text = meters .. "M"
    end
end

for _, player in ipairs(Players:GetPlayers()) do createPlayerOverlay(player) end
local playerAddedConnection = Players.PlayerAdded:Connect(createPlayerOverlay)
local playerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
    if Aimbot.LockedPlayer == player then Aimbot.LockedPlayer = nil end
    removePlayerOverlay(player)
end)

-- ============================================================
-- Main loop
-- ============================================================
local function updateFeatures(dt)
    local camera = workspace.CurrentCamera
    if not camera then return end

    refreshVisibilityFilter()
    updateAimbot(camera, dt)

    for player, overlay in pairs(PlayerOverlays) do
        updatePlayerOverlay(player, overlay, camera)
    end
end

