-- ============================================================
-- Targeting
-- ============================================================
local VisibilityParams = RaycastParams.new()
VisibilityParams.FilterType = Enum.RaycastFilterType.Exclude
VisibilityParams.IgnoreWater = true
VisibilityParams.RespectCanCollide = true -- ghost parts (accessories, triggers) do not block the ray
local visibilityFilterCharacter = nil

local function refreshVisibilityFilter()
    local character = LocalPlayer.Character
    if character ~= visibilityFilterCharacter then
        visibilityFilterCharacter = character
        VisibilityParams.FilterDescendantsInstances = character and {character} or {}
    end
end

local VISIBILITY_PARTS = {"Head", "UpperTorso", "HumanoidRootPart", "Torso"}

-- True when at least one body part is not blocked by geometry.
local function isCharacterVisible(character, camera)
    local origin = camera.CFrame.Position
    for _, partName in ipairs(VISIBILITY_PARTS) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local result = workspace:Raycast(origin, part.Position - origin, VisibilityParams)
            if result == nil or result.Instance:IsDescendantOf(character) then
                return true
            end
        end
    end
    return false
end

local function getCharacterPart(character, partName)
    local requested = character:FindFirstChild(partName)
    if requested and requested:IsA("BasePart") then return requested end
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then return head end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    return nil
end

local function isTeammate(player)
    return LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team
end

-- Returns the part to aim at and its pixel distance from `reference`, or nil when the player is not a valid target.
-- Cheap checks run first, the raycast runs last.
local function evaluateCandidate(player, camera, reference)
    local character = player.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return nil end
    if character:FindFirstChildOfClass("ForceField") then return nil end
    if Settings.TeamCheck and isTeammate(player) then return nil end

    local part = getCharacterPart(character, Settings.AimbotPart)
    if not part then return nil end

    if (part.Position - camera.CFrame.Position).Magnitude > Settings.AimbotMaxDistance then return nil end

    local screen, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen or screen.Z <= 0 then return nil end
    local pixelDistance = (Vector2.new(screen.X, screen.Y) - reference).Magnitude
    if pixelDistance > Settings.AimbotFOV then return nil end

    if Settings.VisibleCheck and not isCharacterVisible(character, camera) then return nil end
    return part, pixelDistance
end

-- Closest valid target to `reference`. Returns part, player.
local function findBestTarget(camera, reference)
    local bestPart, bestPlayer, bestDistance = nil, nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local part, distance = evaluateCandidate(player, camera, reference)
            if part and distance < bestDistance then
                bestPart, bestPlayer, bestDistance = part, player, distance
            end
        end
    end
    return bestPart, bestPlayer
end

