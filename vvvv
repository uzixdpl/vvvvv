-- Unload
-- ============================================================
local cleanedUp = false
local function cleanup()
    if cleanedUp then return end
    cleanedUp = true

    for _, connection in ipairs(Runtime.Connections) do pcall(function() connection:Disconnect() end) end
    Runtime.Connections = {}

    pcall(function() RunService:UnbindFromRenderStep(RENDER_STEP_NAME) end)
    if playerAddedConnection then playerAddedConnection:Disconnect() end
    if playerRemovingConnection then playerRemovingConnection:Disconnect() end
    if MenuCursor.Connection then MenuCursor.Connection:Disconnect() end
    if TabAnimation.Indicator then TabAnimation.Indicator:Cancel() end
    for _, tween in pairs(TabAnimation.Pages) do pcall(function() tween:Cancel() end) end
    for _, tween in pairs(ScrollTweens) do pcall(function() tween:Cancel() end) end
    for player in pairs(PlayerOverlays) do removePlayerOverlay(player) end

    if menuOpen then
        menuOpen = false
        if MenuCursor.Behavior ~= nil then UserInputService.MouseBehavior = MenuCursor.Behavior end
        if MenuCursor.IconEnabled ~= nil then UserInputService.MouseIconEnabled = MenuCursor.IconEnabled end
    end

    if globalEnv.__VantaLolCleanup == cleanup then globalEnv.__VantaLolCleanup = nil end
    pcall(function() ScreenGui:Destroy() end)
end

ScreenGui.Destroying:Connect(cleanup)
Runtime.Unload = cleanup
globalEnv.__VantaLolCleanup = cleanup

