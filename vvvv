local notify
do
    local holder = Instance.new("Frame")
    holder.Name = "Toasts"
    holder.AnchorPoint = Vector2.new(0.5, 1)
    holder.Position = UDim2.new(0.5, 0, 1, -28)
    holder.Size = UDim2.fromOffset(320, 220)
    holder.BackgroundTransparency = 1
    holder.ZIndex = 60
    holder.Parent = ScreenGui

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Parent = holder

    local fade = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local counter = 0

    notify = function(text, kind)
        counter = counter + 1
        local accent = WHITE
        if kind == "error" then accent = Colors.Red elseif kind == "success" then accent = Colors.Green end

        local toast = Instance.new("TextLabel")
        toast.LayoutOrder = counter
        toast.Size = UDim2.fromOffset(280, 32)
        toast.BackgroundColor3 = Colors.Panel
        toast.BackgroundTransparency = 1
        toast.BorderSizePixel = 0
        toast.Font = Fonts.Medium
        toast.Text = tostring(text)
        toast.TextColor3 = Colors.Text
        toast.TextTransparency = 1
        toast.TextSize = 13
        toast.TextTruncate = Enum.TextTruncate.AtEnd
        toast.ZIndex = 61
        toast.Parent = holder
        round(toast, 16)
        local toastStroke = stroke(toast, accent, 1, 1)

        TweenService:Create(toast, fade, {BackgroundTransparency = 0.05, TextTransparency = 0}):Play()
        TweenService:Create(toastStroke, fade, {Transparency = 0.45}):Play()

        task.delay(2.4, function()
            pcall(function()
                TweenService:Create(toast, fade, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
                TweenService:Create(toastStroke, fade, {Transparency = 1}):Play()
            end)
            task.delay(0.3, function() pcall(function() toast:Destroy() end) end)
        end)
    end
end

-- ============================================================
-- Logo (embedded PNG -> written to the executor workspace -> getcustomasset)
-- ============================================================
local LOGO_BASE64 = [==[]==]

local LogoAsset = (function()
    local getAsset = getcustomasset or getsynasset
    if type(writefile) ~= "function" or type(getAsset) ~= "function" then return nil end

    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #alphabet do lookup[alphabet:byte(i)] = i - 1 end

    local ok, asset = pcall(function()
        local bytes, count, bits, value = {}, 0, 0, 0
        for i = 1, #LOGO_BASE64 do
            local sextet = lookup[LOGO_BASE64:byte(i)]
            if sextet then
                value = value * 64 + sextet
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    local divisor = 2 ^ bits
                    count = count + 1
                    bytes[count] = string.char(math.floor(value / divisor))
                    value = value % divisor
                end
            end
        end
        writefile("vanta_logo.png", table.concat(bytes))
        return getAsset("vanta_logo.png")
    end)
    if ok and type(asset) == "string" and asset ~= "" then return asset end
    return nil
end)()

