-- Tab switching: the page slides in and the indicator glides (always on).
local TabAnimation = {Pages = {}, Indicator = nil}

local function selectTab(index)
    if not Pages[index] then return end
    local previous = activeTab
    local direction = (index >= previous) and 1 or -1
    activeTab = index

    for i, button in ipairs(TabButtons) do
        button.TextColor3 = (i == index) and WHITE or Colors.Muted
        local page = Pages[i]
        if TabAnimation.Pages[i] then
            TabAnimation.Pages[i]:Cancel()
            TabAnimation.Pages[i] = nil
        end

        if i == index then
            page.Visible = true
            if previous ~= index then
                page.Position = UDim2.fromOffset(direction * 18, 0)
                local tween = TweenService:Create(page,
                    TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                    {Position = UDim2.fromOffset(0, 0)})
                TabAnimation.Pages[i] = tween
                tween:Play()
            else
                page.Position = UDim2.fromOffset(0, 0)
            end
        else
            page.Visible = false
            page.Position = UDim2.fromOffset(0, 0)
        end
    end

    if TabAnimation.Indicator then TabAnimation.Indicator:Cancel() end
    TabAnimation.Indicator = TweenService:Create(TabIndicator,
        TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {Position = UDim2.new((index - 1) / #TabNames, 14, 1, -2)})
    TabAnimation.Indicator:Play()
end

for i, button in ipairs(TabButtons) do
    button.MouseButton1Click:Connect(function() selectTab(i) end)
    button.MouseEnter:Connect(function()
        if i ~= activeTab then button.TextColor3 = Colors.Text end
    end)
    button.MouseLeave:Connect(function()
        if i ~= activeTab then button.TextColor3 = Colors.Muted end
    end)
end

-- Smooth mouse wheel scrolling
local ScrollTweens = {}
Input.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    local mouse = UserInputService:GetMouseLocation()
    for _, page in ipairs(Pages) do
        if page.Visible then
            local pos, size = page.AbsolutePosition, page.AbsoluteSize
            local inside = mouse.X >= pos.X and mouse.X <= pos.X + size.X
                and mouse.Y >= pos.Y and mouse.Y <= pos.Y + size.Y
            if inside then
                local maxScroll = math.max(0, page.CanvasSize.Y.Offset - size.Y)
                local targetY = math.clamp(page.CanvasPosition.Y - input.Position.Z * 92, 0, maxScroll)
                if ScrollTweens[page] then ScrollTweens[page]:Cancel() end
                ScrollTweens[page] = TweenService:Create(page,
                    TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                    {CanvasPosition = Vector2.new(0, targetY)})
                ScrollTweens[page]:Play()
                break
            end
        end
    end
end)

